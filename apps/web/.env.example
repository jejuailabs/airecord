# --- 번역 엔진 ---
TRANSLATION_PRIMARY_PROVIDER=openai        # openai | google
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
# 모델명은 하드코딩하지 않는다 (core.md §3-7). 2026-07 비교 후 통역 전용 모델로 확정.
TRANSLATION_MODEL_OPENAI=gpt-realtime-translate
TRANSCRIPTION_MODEL=gpt-realtime-whisper
# 텍스트·문서 번역용 (실시간과 분리 — 정확도 우선)
TEXT_TRANSLATION_MODEL=gpt-5
# 번역은 깊은 추론이 필요 없다. minimal이면 2~3초, 기본값이면 10초 넘는다(실측)
TEXT_TRANSLATION_EFFORT=minimal
# 이미지(사진·스캔) 번역용 비전 모델
VISION_TRANSLATION_MODEL=gpt-5
VISION_TRANSLATION_EFFORT=low

# --- 세션 보호 (core.md §3-6: 하드 캡 없이 세션을 열지 않는다) ---
# 개발 중에는 짧게(300) 두어 실비 사고를 막는다 (docs/02 §4)
SESSION_MAX_DURATION_SEC=300
TRIAL_MAX_DURATION_SEC=120

# --- 과금·원가 (docs/07 — 2026-07-26 조사값. 분기마다 재확인) ---
COST_TRANSLATE_USD_PER_MIN=0.034
COST_BOT_USD_PER_MIN=0.00833
COST_INFRA_OVERHEAD_PCT=0.10
USD_KRW_RATE=1400                           # ⚠ 확정 아님. 운영 시 실환율로 갱신

# --- Firebase (Phase 2부터) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# --- 회의 봇 (Phase 4) ---
RECALL_API_KEY=
RECALL_REGION=
RECALL_WEBHOOK_SECRET=

# --- Worker 연동 (Phase 4) ---
WORKER_BASE_URL=
WORKER_SHARED_SECRET=

# --- 기타 ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
